# Z-Library MCP Server Environment Configuration
# Copy this file to .env and fill in your credentials

# Single-account credentials (used when ZLIBRARY_ACCOUNTS is unset)
ZLIBRARY_EMAIL=your@email.com
ZLIBRARY_PASSWORD=your_password_here

# Optional: User-provided account pool, takes precedence over the single account
# ZLIBRARY_ACCOUNTS='[{"email":"first@example.com","password":"first_password"},{"email":"second@example.com","password":"second_password"}]'
# Switches on rejected login or exhausted download quota; network errors use normal retries
# Optional: Preference state file (default: .cache/zlibrary-account-pool.json in the package)
# ZLIBRARY_ACCOUNT_STATE_FILE=/absolute/path/to/zlibrary-account-pool.json

# Optional: Custom Z-Library mirror URL
# ZLIBRARY_MIRROR=https://your-mirror.example

# Optional: Anna's Archive API key (from donation)
# Get your key at: https://annas-archive.li/donate
ANNAS_SECRET_KEY=your_secret_key_here

# Optional: Anna's Archive mirror (if main domain is down)
# ANNAS_BASE_URL=https://annas-archive.li

# Optional: LibGen mirror extension (li, bz, gs, etc.)
# LIBGEN_MIRROR=li

# Optional MCP backends (installed as pinned optional npm dependencies)
# Default: both installed backends participate in source="all".
# Set an empty value to disable them; force a backend with source="libgen_mcp" or "find_a_book".
# BOOKHARBOR_MCP_SOURCES=libgen_mcp,find_a_book
# Optional find-a-book mirror override (comma-separated full base URLs)
# LIBGEN_MIRRORS=https://libgen.li,https://libgen.rs
# Book Download MCP does not forward Z-Library credentials or Anna's keys to these backends.

# Optional: Retry configuration
# RETRY_MAX_RETRIES=3
# RETRY_INITIAL_DELAY=1000
# RETRY_MAX_DELAY=30000

# Optional: Circuit breaker configuration
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT=60000
